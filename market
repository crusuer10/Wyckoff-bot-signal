#!/usr/bin/env bash

# web scraper.
# fetching data using curl then pass them into json to be analyzed.

_symbol="GC=F"
_output="gold_history.json"

scrape_data() {

_response=$(curl -s --fail -L \
-H "User-Agent: Mozilla/5.0" \
"https://query1.finance.yahoo.com/v8/finance/chart/${_symbol}?range=1mo&interval=10m")
[ -z "$_response" ] && { echo "[ERROR] market data cant be reached"; return 1; }
echo "$_response" | jq -e '.chart.result[0].timestamp' >/dev/null || { printf '%s\n' "[ERROR] invalid data."; return 1; }
echo "$_response" > "$_output"

}

scrape_data
