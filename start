#!/usr/bin/env bash

SLEEP=15

command -v awk >/dev/null || { echo "You need awk to be able to run this script."; exit 1; }
command -v jq >/dev/null  || { echo "jq  not installed in your system."; exit 1; }

trap 'echo "CTRL-C pressed, exiting.."; exit 0' SIGINT


start() {

while :; do

   clear
   echo "checking prices.."
     if  ./market; then
        echo "analyzing.." && ./wyckoff || {
              echo "[ERROR] something went wrong"; exit 1; }
     fi
       sleep $SLEEP
done
}

start
