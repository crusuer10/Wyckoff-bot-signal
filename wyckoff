#!/usr/bin/env bash

# somewhat the wyckoff algorithm, or just
# wyckoff analyzer.


GREEN='\033[0;32m'
RED='\033[0;31m'
ORANGE='\033[0;33m'
NC='\033[0m'  # Reset color
INPUT="gold_history.json"

 [ ! -f "$INPUT" ] && { echo "[ERROR] JSON file not found"; exit 1; }

jq -r '
.chart.result[0] as $r |
$r.indicators.quote[0] as $q |
range(0; ($r.timestamp | length)) |
select($q.close[.] != null and $q.high[.] != null and $q.low[.] != null and $q.volume[.] != null) |
[$q.close[.], $q.high[.], $q.low[.], $q.volume[.]] | @tsv
' "$INPUT" | awk '

{
    closing[NR] = $1
    highs[NR] = $2
    lows[NR] = $3
    volumes[NR] = $4
}

END {

    n = NR

    if (n < 21) {
        print "[ERROR] Need at least 21 candles"
        exit 1
    }

    resistance = highs[n-20]
    support = lows[n-20]
    avg_volume = 0

    for (i = n-20; i < n; i++) {
        if (highs[i] > resistance) resistance = highs[i]
        if (lows[i] < support) support = lows[i]
        avg_volume += volumes[i]
    }

    avg_volume /= 20

    current_close = closing[n]
    current_high = highs[n]
    current_low = lows[n]
    current_volume = volumes[n]

    volume_ratio = (avg_volume > 0) ? current_volume / avg_volume : 0

    signal = "WAIT"
    reason = "No confirmed Wyckoff event"

    if (current_low < support && current_close > support && volume_ratio > 1.2) {
        signal = "BUY CANDIDATE"
        reason = "Potential Spring"
    }
    else if (current_high > resistance && current_close < resistance && volume_ratio > 1.2) {
        signal = "SELL CANDIDATE"
        reason = "Potential Upthrust"
    }
    else if (current_close > resistance && volume_ratio > 1.5) {
        signal = "BUY"
        reason = "Potential Sign of Strength (SOS)"
    }
    else if (current_close < support && volume_ratio > 1.5) {
        signal = "SELL"
        reason = "Potential Sign of Weakness (SOW)"
    }

    print ""
    print "========== WYCKOFF ANALYSIS =========="
    printf "Current price:    %.2f\n", current_close
    printf "Support:          %.2f\n", support
    printf "Resistance:       %.2f\n", resistance
    printf "Volume ratio:     %.2fx\n", volume_ratio
    print "--------------------------------------"
    printf "Wyckoff event:    %s\n", reason
    printf "Trading signal:   %s\n", signal
    print "======================================"
    print ""
}
'
